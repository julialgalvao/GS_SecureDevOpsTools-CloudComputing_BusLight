terraform {
  required_version = ">= 1.6"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.0"
    }
    tls = {
      source  = "hashicorp/tls"
      version = "~> 4.0"
    }
  }
}

provider "azurerm" {
  features {}
  # a assinatura vem do `az login` (ou da variável de ambiente ARM_SUBSCRIPTION_ID)
  subscription_id = var.subscription_id
}
